<?xml version="1.0" encoding="utf-8"?>
<!--
    StackView 카드 아이템 레이아웃 (4x2 위젯 오른쪽 영역 기준)
    - widget_stack_card_body 전체 클릭: 해당 카테고리 상세 화면으로 이동
    - widget_stack_quick_action 클릭: 빠른 기록 (물 / 스트레칭) 또는 앱 화면 이동 (식사 / 디지털)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_stack_card_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingRight="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="center_vertical">

    <!-- 카테고리명 칩 -->
    <TextView
        android:id="@+id/widget_stack_category_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="양호"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#FF6D4C41"
        android:background="@drawable/widget_status_chip_background"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp" />

    <!-- 상태 문구 -->
    <TextView
        android:id="@+id/widget_stack_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="오늘 습관 상태 좋아! 계속 유지해보자!"
        android:textSize="11sp"
        android:textColor="#FF424242"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- 간단 설명 -->
    <TextView
        android:id="@+id/widget_stack_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textSize="9sp"
        android:textColor="#FF757575"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 빠른 기록 / 이동 버튼 -->
    <TextView
        android:id="@+id/widget_stack_quick_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="기록하러 가기"
        android:textSize="10sp"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/widget_button_background"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

</LinearLayout>
