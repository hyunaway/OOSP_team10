<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="@dimen/widget_padding_outer">

    <!--
        왼쪽 영역 (전체의 ~40%)
        상단: 복합 위험 상태 도트 아이콘 4개 (한 줄)
        중앙: 대표 아바타 (dominantCategory 기반, 고정 위치)
    -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2">

        <!-- 상단: 복합 위험 상태 아이콘 4개 -->
        <LinearLayout
            android:id="@+id/widget_dots_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_alignParentTop="true"
            android:padding="4dp">

            <ImageView
                android:id="@+id/widget_status_icon_meal"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_dot_meal"
                android:contentDescription="" />

            <ImageView
                android:id="@+id/widget_status_icon_water"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_dot_water"
                android:contentDescription=""
                android:layout_marginLeft="4dp" />

            <ImageView
                android:id="@+id/widget_status_icon_digital"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_dot_digital"
                android:contentDescription=""
                android:layout_marginLeft="4dp" />

            <ImageView
                android:id="@+id/widget_status_icon_stretch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_dot_stretch"
                android:contentDescription=""
                android:layout_marginLeft="4dp" />

        </LinearLayout>

        <!-- 중앙: 대표 아바타 (도트 아래 ~ 패널 하단 전체) -->
        <ImageView
            android:id="@+id/widget_avatar_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/widget_dots_row"
            android:layout_alignParentBottom="true"
            android:scaleType="fitCenter"
            android:contentDescription=""
            android:src="@drawable/widget_avatar_male_good" />

    </RelativeLayout>

    <!--
        오른쪽 영역 (전체의 ~60%): ViewFlipper — 카드 1장씩 표시, ◀▶ 버튼으로 전환
    -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:orientation="vertical">

        <ViewFlipper
            android:id="@+id/widget_view_flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_btn_prev"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:text="◀"
                android:gravity="center"
                android:textColor="@color/widget_text_sub"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_btn_next"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:text="▶"
                android:gravity="center"
                android:textColor="@color/widget_text_sub"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!--
        레거시 호환 영역 — visibility="gone" 이므로 화면에 표시되지 않는다.
        WidgetUpdateHelper.buildRemoteViews 및 HabitStatusWidgetProvider.attachPendingIntents
        에서 참조하는 구 View ID를 유지한다.
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_brand_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_speech_text"
            style="@style/WidgetTextStyle.StatusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_status_label"
            style="@style/WidgetTextStyle.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <ImageView
            android:id="@+id/widget_sub_status_1_icon"
            android:layout_width="@dimen/widget_icon_size"
            android:layout_height="@dimen/widget_icon_size" />
        <TextView
            android:id="@+id/widget_sub_status_1_text"
            style="@style/WidgetTextStyle.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <ImageView
            android:id="@+id/widget_sub_status_2_icon"
            android:layout_width="@dimen/widget_icon_size"
            android:layout_height="@dimen/widget_icon_size" />
        <TextView
            android:id="@+id/widget_sub_status_2_text"
            style="@style/WidgetTextStyle.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <ImageView
            android:id="@+id/widget_sub_status_3_icon"
            android:layout_width="@dimen/widget_icon_size"
            android:layout_height="@dimen/widget_icon_size" />
        <TextView
            android:id="@+id/widget_sub_status_3_text"
            style="@style/WidgetTextStyle.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_action_button"
            style="@style/WidgetTextStyle.ActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:id="@+id/widget_right_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_card_category_name"
                style="@style/WidgetTextStyle.CategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/widget_card_message"
                style="@style/WidgetTextStyle.StatusMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/widget_card_description"
                style="@style/WidgetTextStyle.Description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/widget_card_quick_action"
                style="@style/WidgetTextStyle.ActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView
            android:id="@+id/avatarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/waterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/abnormalStatusText"
            style="@style/WidgetTextStyle.StatusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/speechText"
            style="@style/WidgetTextStyle.StatusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/stretchText"
            style="@style/WidgetTextStyle.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/addWaterButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
        <Button
            android:id="@+id/stretchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
        <Button
            android:id="@+id/openAppButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />

    </LinearLayout>

</LinearLayout>
