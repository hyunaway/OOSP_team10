<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!--
        왼쪽 영역 (전체의 ~40%)
        위: 복합 위험 상태 도트 아이콘 4개 (한 줄)
        중앙: 대표 아바타 (dominantCategory 기반, 오른쪽 카드 전환과 무관하게 고정)
    -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- 복합 위험 상태 아이콘 4개 (가로 한 줄) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginBottom="4dp">

            <ImageView
                android:id="@+id/widget_status_icon_meal"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/widget_dot_inactive"
                android:contentDescription="" />

            <ImageView
                android:id="@+id/widget_status_icon_water"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/widget_dot_inactive"
                android:contentDescription=""
                android:layout_marginLeft="6dp" />

            <ImageView
                android:id="@+id/widget_status_icon_digital"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/widget_dot_inactive"
                android:contentDescription=""
                android:layout_marginLeft="6dp" />

            <ImageView
                android:id="@+id/widget_status_icon_stretch"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/widget_dot_inactive"
                android:contentDescription=""
                android:layout_marginLeft="6dp" />

        </LinearLayout>

        <!-- 대표 아바타 (남은 공간을 모두 채움) -->
        <ImageView
            android:id="@+id/widget_avatar_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:contentDescription=""
            android:src="@drawable/widget_avatar_male_good" />

    </LinearLayout>

    <!--
        오른쪽 영역 (전체의 ~60%): StackView — 사용자 우선순위 순서의 4개 카드
        사용자가 카드를 직접 넘길 수 있음. 왼쪽 아바타와 무관하게 독립 동작.
    -->
    <StackView
        android:id="@+id/widget_stack_view"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3" />

    <!--
        레거시 호환 영역 — visibility="gone" 이므로 화면에 표시되지 않는다.
        WidgetUpdateHelper.buildRemoteViews 및 HabitStatusWidgetProvider.attachPendingIntents
        에서 참조하는 구 View ID를 유지한다.
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_brand_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_speech_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <ImageView
            android:id="@+id/widget_sub_status_1_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_sub_status_1_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <ImageView
            android:id="@+id/widget_sub_status_2_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_sub_status_2_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <ImageView
            android:id="@+id/widget_sub_status_3_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_sub_status_3_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/widget_action_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:id="@+id/widget_right_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_card_category_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/widget_card_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/widget_card_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/widget_card_quick_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView
            android:id="@+id/avatarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/waterText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/abnormalStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/speechText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/stretchText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <Button
            android:id="@+id/addWaterButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
        <Button
            android:id="@+id/stretchButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />
        <Button
            android:id="@+id/openAppButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="" />

    </LinearLayout>

</LinearLayout>
