<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Widget text styles -->

    <style name="WidgetTextStyle" />

    <style name="WidgetTextStyle.CategoryTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/widget_text_main</item>
    </style>

    <style name="WidgetTextStyle.StatusMessage">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/widget_accent_orange</item>
    </style>

    <style name="WidgetTextStyle.Description">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/widget_text_sub</item>
    </style>

    <style name="WidgetTextStyle.ActionButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/widget_accent_orange</item>
        <item name="android:background">@color/widget_button_background</item>
    </style>

</resources>
